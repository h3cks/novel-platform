datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// ==========================================
// ENUMS (Перелічувані типи)
// ==========================================

enum UserRole {
  READER
  AUTHOR
  MODERATOR
  ADMIN
}

enum NovelStatus {
  DRAFT
  REVIEWING
  PUBLISHED
  BLOCKED
}

enum ReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
  ESCALATED
}

// ==========================================
// CORE: Користувачі та Автентифікація
// ==========================================

model User {
  id                   Int       @id @default(autoincrement())
  email                String?   @unique
  username             String?   @unique
  password             String
  displayName          String?
  emailConfirmed       Boolean   @default(false)
  emailConfirmToken    String?   @db.VarChar(255)
  emailConfirmExpires  DateTime?
  passwordResetToken   String?   @db.VarChar(255)
  passwordResetExpires DateTime?
  avatarUrl            String?
  role                 UserRole  @default(READER)
  isBlocked            Boolean   @default(false)
  lastActive           DateTime  @default(now())
  createdAt            DateTime  @default(now())

  // Зв'язки
  novels           Novel[]
  comments         Comment[]
  ratings          Rating[]
  follows          Follow[]
  views            ViewHistory[]
  reports          Report[]
  notifications    Notification[]

  // Специфічні зв'язки (Аудит, Модерація, Підписки)
  processedReports Report[]     @relation("ProcessedBy")
  auditLogs        AuditLog[]   @relation("AuditActor")
  following        UserFollow[] @relation("Follower")
  followers        UserFollow[] @relation("Author")
}

// ==========================================
// CONTENT: Новели та Розділи
// ==========================================

model Novel {
  id            Int         @id @default(autoincrement())
  authorId      Int
  author        User        @relation(fields: [authorId], references: [id])
  title         String
  description   String?
  status        NovelStatus @default(DRAFT)
  coverUrl      String?
  autoPublished Boolean     @default(false)
  publishedAt   DateTime?
  wordCount     Int?
  flagged       Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Зв'язки
  chapters  Chapter[]
  comments  Comment[]
  ratings   Rating[]
  tags      NovelTag[]
  genres    NovelGenre[]
  followers Follow[]
  views     ViewHistory[]

  @@index([title])
  @@index([status])
  @@index([authorId])
}

model Chapter {
  id            Int      @id @default(autoincrement())
  novelId       Int
  novel         Novel    @relation(fields: [novelId], references: [id])
  title         String
  content       String   @db.Text
  wordCount     Int?
  order         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  languageRatio Float?

  // Зв'язки
  comments      Comment[]
  views         ViewHistory[]

  @@unique([novelId, order])
}

// ==========================================
// TAXONOMY: Жанри та Теги (зв'язки Багато-до-Багатьох)
// ==========================================

model Genre {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String?  @unique
  description String?
  createdAt   DateTime @default(now())

  novels NovelGenre[]

  @@index([name])
  @@index([slug])
}

model NovelGenre {
  novelId Int
  genreId Int
  novel   Novel @relation(fields: [novelId], references: [id])
  genre   Genre @relation(fields: [genreId], references: [id])

  @@id([novelId, genreId])
}

model Tag {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String?  @unique
  description String?
  createdAt   DateTime @default(now())

  novels NovelTag[]

  @@index([name])
  @@index([slug])
}

model NovelTag {
  novelId Int
  tagId   Int
  novel   Novel @relation(fields: [novelId], references: [id])
  tag     Tag   @relation(fields: [tagId], references: [id])

  @@id([novelId, tagId])
}

// ==========================================
// SOCIAL: Взаємодія, Коментарі, Оцінки
// ==========================================

model Comment {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  novelId   Int?
  novel     Novel?    @relation(fields: [novelId], references: [id])
  chapterId Int?
  chapter   Chapter?  @relation(fields: [chapterId], references: [id])
  parentId  Int?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  text      String    @db.Text
  deleted   Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([novelId])
  @@index([chapterId])
  @@index([parentId])
}

model Rating {
  id      Int   @id @default(autoincrement())
  novelId Int
  novel   Novel @relation(fields: [novelId], references: [id])
  userId  Int
  user    User  @relation(fields: [userId], references: [id])
  score   Int

  @@unique([novelId, userId])
}

model Follow {
  userId    Int
  novelId   Int
  user      User  @relation(fields: [userId], references: [id])
  novel     Novel @relation(fields: [novelId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, novelId])
}

model UserFollow {
  followerId Int
  authorId   Int
  follower   User  @relation("Follower", fields: [followerId], references: [id])
  author     User  @relation("Author", fields: [authorId], references: [id])
  createdAt  DateTime @default(now())

  @@id([followerId, authorId])
}

model ViewHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  novelId   Int?
  novel     Novel?   @relation(fields: [novelId], references: [id])
  chapterId Int?
  chapter   Chapter? @relation(fields: [chapterId], references: [id])
  viewedAt  DateTime @default(now())

  @@index([novelId])
  @@index([chapterId])
  @@index([userId])
}

// ==========================================
// SYSTEM: Модерація, Аудит та Сповіщення
// ==========================================

model Report {
  id         Int      @id @default(autoincrement())
  reporterId Int
  reporter   User     @relation(fields: [reporterId], references: [id])

  // Поліморфний зв'язок (Тип об'єкта та його ID)
  targetType String
  targetId   Int
  reason     String
  detail     String?
  createdAt  DateTime @default(now())

  // Обробка модератором
  status           ReportStatus @default(OPEN)
  moderatorId      Int?
  moderator        User?        @relation("ProcessedBy", fields: [moderatorId], references: [id])
  moderatorComment String?
  actionTaken      String?
  actionTakenNote  String?

  @@index([targetType, targetId])
  @@index([status])
  @@index([reporterId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   Int
  reason     String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Notification {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  type       String
  targetType String?
  targetId   Int?
  taskId     Int?
  actorId    Int?
  message    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
}